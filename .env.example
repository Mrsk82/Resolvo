# Resolvo — environment configuration example. Copy to .env and fill in real
# values. Never commit .env with real secrets.

# ── Core ─────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
DEPLOY_SECRET=changeme
SKIP_AUTH=false

# ── Email (existing) ────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ── AI (existing) ────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Slack (existing) ─────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── External issue tracker (existing) ────────────────────────────────────
EXTERNAL_API_TYPE=
EXTERNAL_API_BASE_URL=
EXTERNAL_API_TOKEN=
EXTERNAL_API_USER=
EXTERNAL_API_PROJECT_KEY=

# ── Social Channels & Unified Social Inbox ──────────────────────────────
# Encryption key for social credentials at rest (integrations/social/crypto.js).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_CREDENTIALS_KEY=

# One Meta App (developers.facebook.com) covers both Instagram + Facebook —
# each tenant connects their own Page/IG account through this shared app via
# OAuth, same pattern as the existing Gmail OAuth integration.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Random string you choose yourself; must match what you enter in the Meta
# App Dashboard's webhook "Verify Token" field.
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Business — TWO integration paths exist, per-brand choice under
# Settings → WhatsApp:
#  1. Twilio (default, works today) — no new variables, per-brand config
#     already lives under Settings → Email & Ticketing → WhatsApp.
#  2. Direct Meta Cloud API ("Tech Provider" model) — removes Twilio's markup
#     on top of Meta's own per-conversation fee. Requires the platform
#     owner's Meta Business Verification + a Meta App with the WhatsApp
#     product added. A "config_id" for Embedded Signup is created in that
#     App's Dashboard once verification is approved.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Can reuse META_WEBHOOK_VERIFY_TOKEN below if you'd rather not manage a
# second verify token for the same Meta App.
WHATSAPP_META_VERIFY_TOKEN=

# Google Cloud OAuth client for YouTube Data API (Phase 2)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Telegram — NOT a shared app credential. Each tenant creates their own bot
# via @BotFather inside the app (Settings → Social Channels → Telegram →
# Connect) and pastes their own bot token there. Nothing to set here.

# LinkedIn Marketing Developer Platform app (Phase 3 — requires partner
# approval before organization social endpoints activate; see capability-matrix.js)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) API app (Phase 3 — mentions/DMs require a paid API tier;
# see capability-matrix.js)
X_CLIENT_ID=
X_CLIENT_SECRET=
